{
  "name": "local-service-status-api",
  "version": "1.0.0",
  "description": "A public, read-only API for reporting Pterodactyl Minecraft and local service health.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cheslin23t/service-status-api.git"
  },
  "keywords": [
    "pterodactyl",
    "minecraft",
    "status-api",
    "fastify"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "fastify": "^5.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^5.0.5"
  }
}
